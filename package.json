{
  "name": "halara-coffee-club-dashboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch server/dev.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.server.json",
    "start": "node dist-server/start.js",
    "db:reset": "tsx server/reset.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.2.0",
    "@types/pdfkit": "^0.17.6",
    "@types/supertest": "^7.2.1",
    "nanoid": "^3.3.17",
    "supertest": "^7.2.2",
    "tsx": "^4.23.11",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "argon2": "^0.45.1",
    "better-sqlite3": "^13.0.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "lucide": "^1.28.0",
    "multer": "^2.2.0",
    "pdfkit": "^0.19.1",
    "sharp": "^0.35.3",
    "zod": "^4.4.3"
  }
}
